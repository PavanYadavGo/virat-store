# ==============================================================================
# Virat Store Server — Environment Configuration Template
# Copy this file to .env before starting the server in development or production.
# NEVER commit .env files containing real credentials.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Feature Gate (Controlled Rollout)
# Set to 'true' or '1' to enable transactional endpoints (/api/orders, /api/contact, /api/admin/*).
# Defaults to 'false' to keep the storefront in a safe read-only catalog mode.
BACKEND_FEATURES_ENABLED=false

# Database & Persistence Safety
# In production, ALLOW_IN_MEMORY_FALLBACK is strictly forced to false by the server.
# In development, it defaults to true so frontend development can proceed without local MongoDB.
ALLOW_IN_MEMORY_FALLBACK=true
MONGODB_URI=mongodb://localhost:27017/virat_store

# Authentication & Admin Security
# Replace with a cryptographically secure random string in production.
JWT_SECRET=default_dev_secret_change_in_production
JWT_EXPIRES_IN=7d
INITIAL_ADMIN_EMAIL=admin@viratsports.com
INITIAL_ADMIN_PASSWORD=Admin@Virat2026!

# SMTP Email Relay (Brevo / Nodemailer)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_SENDER_EMAIL=noreply@viratsports.com
CONTACT_RECEIVER_EMAIL=support@viratsports.com

